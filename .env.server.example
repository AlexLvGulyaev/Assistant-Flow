# =============================================================================
# assistant-flow — server deployment (.env.server)
# =============================================================================
# Для docker-compose.assistant.yml и аналогичных серверных сценариев.
# Скопируйте на сервер и заполните. Не коммитить файл с реальными значениями.
#
# Отличия от .env.example (portfolio):
# — ожидается внешний или уже развёрнутый PostgreSQL (хост/порт/роль не из demo-compose);
# — Chroma часто как отдельный контейнер/хост (имя сервиса в вашей сети, например assistant-chroma);
# — пути и домены под продакшен-размещение.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — внешний PostgreSQL
# -----------------------------------------------------------------------------
# Пример: managed Postgres или отдельный хост в Docker-сети инфраструктуры.
DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/assistant_flow

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# -----------------------------------------------------------------------------
# GigaChat
# -----------------------------------------------------------------------------
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=your_gigachat_auth_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_MAX_TOKENS=500

# -----------------------------------------------------------------------------
# OpenAI / ProxyAPI и совместимые эндпоинты
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PROXY_API_KEY=your_proxy_api_key
PROXY_OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXY_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER=proxy

# -----------------------------------------------------------------------------
# RAG / Chroma (имя хоста — как в вашем server compose / internal DNS)
# -----------------------------------------------------------------------------
CHROMA_HOST=assistant-chroma
CHROMA_PORT=8000
CHROMA_USE_HTTP=true
CHROMA_PERSIST_DIR=data/chroma_db
RAG_DOCUMENTS_DIR=data/documents
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_ANSWER_MAX_TOKENS=1500

# -----------------------------------------------------------------------------
# Ассеты (путь внутри контейнера; на хосте маппится в ./storage)
# -----------------------------------------------------------------------------
ASSET_STORAGE_BACKEND=filesystem
ASSET_STORAGE_DIR=/app/storage/assets

# -----------------------------------------------------------------------------
# Аудио
# -----------------------------------------------------------------------------
AUDIO_ENABLED=true
STT_PROVIDER=disabled
TTS_PROVIDER=disabled
AUDIO_STORAGE_NAMESPACE=audio
STT_MODEL=whisper-1
AUDIO_MAX_BYTES=20971520
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_OUTPUT_FORMAT=mp3
TTS_MAX_CHARS=3000

# -----------------------------------------------------------------------------
# Admin API — origins под ваш публичный/внутренний UI (через reverse proxy)
# -----------------------------------------------------------------------------
# Примеры (замените на реальные схемы): https://admin.example.com
# ADMIN_API_CORS_ORIGINS=https://admin.example.com,https://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
LOGS_DB_PATH=logs.db
OUTPUTS_DIR=outputs
