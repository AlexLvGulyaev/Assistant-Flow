# =============================================================================
# assistant-flow — portfolio / local demo (.env)
# =============================================================================
# Скопируйте: cp .env.example .env
# Затем: docker compose -f docker-compose.portfolio.yml up -d --build --remove-orphans
#
# Порты на хосте (compose): Postgres 5433, Chroma 8001, Admin API 8600, UI 8080.
# Внутри Docker-сети сервисы: postgres:5432, chroma:8000 (см. CHROMA_* ниже).
#
# Только плейсхолдеры. Реальные ключи не коммитить.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — PostgreSQL (сервис postgres в docker-compose.portfolio.yml)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://assistant:assistant@postgres:5432/assistant_flow

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Placeholder: контейнер assistant-flow остаётся «в ожидании», Admin API/UI работают.
# Для реального polling укажите токен BotFather (содержит ':').
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# -----------------------------------------------------------------------------
# GigaChat
# -----------------------------------------------------------------------------
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=your_gigachat_auth_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max
GIGACHAT_MAX_TOKENS=500

# -----------------------------------------------------------------------------
# OpenAI / совместимые провайдеры
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PROXY_API_KEY=your_proxy_api_key
PROXY_OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXY_IMAGE_MODEL=gpt-image-1
IMAGE_PROVIDER=proxy

# -----------------------------------------------------------------------------
# RAG / Chroma (HTTP-клиент к сервису chroma в compose)
# -----------------------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_USE_HTTP=true
CHROMA_PERSIST_DIR=data/chroma_db
RAG_DOCUMENTS_DIR=data/documents
# P6.4: hybrid context (KB + dialog memory) в RAG — по умолчанию выключено.
ENABLE_HYBRID_RETRIEVAL=false
# P6.5: offline RAG smoke evaluation (скрипт scripts/evaluate_rag_smoke.py). RAGAS — опционально.
ENABLE_RAGAS_EVALUATION=false
RAG_EVAL_DATASET_PATH=evaluation/datasets/rag_smoke_dataset.json
RAG_EVAL_OUTPUT_DIR=outputs/evaluation
# P6.6: локальный SQLite cache (retrieval/answer по умолчанию выключены).
CACHE_DB_PATH=storage/cache/assistant_cache.sqlite3
ENABLE_RETRIEVAL_CACHE=false
ENABLE_ANSWER_CACHE=false
RETRIEVAL_CACHE_TTL_SECONDS=86400
ANSWER_CACHE_TTL_SECONDS=86400
# Bump после reindex / смены корпуса, чтобы сбросить retrieval cache (см. invalidate_retrieval_cache).
# RAG_RETRIEVAL_GENERATION=
RAG_TOP_K=3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_ANSWER_MAX_TOKENS=1500

# -----------------------------------------------------------------------------
# Хранилище ассетов (volume ./storage → /app/storage)
# -----------------------------------------------------------------------------
ASSET_STORAGE_BACKEND=filesystem
ASSET_STORAGE_DIR=/app/storage/assets

# -----------------------------------------------------------------------------
# Аудио (опционально)
# -----------------------------------------------------------------------------
AUDIO_ENABLED=true
STT_PROVIDER=disabled
TTS_PROVIDER=disabled
AUDIO_STORAGE_NAMESPACE=audio
STT_MODEL=whisper-1
AUDIO_MAX_BYTES=20971520
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_OUTPUT_FORMAT=mp3
TTS_MAX_CHARS=3000

# -----------------------------------------------------------------------------
# Admin API / UI (браузер на хосте → API на опубликованном порту 8600)
# -----------------------------------------------------------------------------
ADMIN_API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Локальные пути внутри контейнера приложения
# -----------------------------------------------------------------------------
LOGS_DB_PATH=logs.db
OUTPUTS_DIR=outputs
